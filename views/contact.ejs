<%- include("partials/header") %>

<section class="contact">
  <div class="container">

    <!-- Page Header -->
    <header class="section-header" data-aos="zoom-in">
      <h1>Contact Me</h1>
      <p>
        Interested in working together or have a project in mind?
        Let’s connect and build something impactful.
      </p>
    </header>

    <div class="contact-content">

      <!-- Contact Info -->
      <div class="contact-info" data-aos="fade-right">
        <h2>Get in Touch</h2>
        <p>
          I’m always open to discussing new opportunities, freelance projects,
          or collaborations related to mobile apps, SDKs, and platform
          engineering.
        </p>

        <ul class="contact-list">
          <li>
            <strong>Email:</strong>
            <a href="mailto:anaslokhandwala0@gmail.com">
              anaslokhandwala0@gmail.com
            </a>
          </li>
          <li>
            <strong>Phone:</strong>
            <a href="tel:+919773111024">
              +91 97731 11024
            </a>
          </li>
          <li>
            <strong>Location:</strong>
            Mumbai, India
          </li>
          <li>
            <strong>LinkedIn:</strong>
            <a href="https://www.linkedin.com/in/anas-lokhandwala" target="_blank">
              linkedin.com/in/anas-lokhandwala
            </a>
          </li>
          <li>
            <strong>GitHub:</strong>
            <a href="https://github.com/AnasLokhandwala" target="_blank">
              github.com/AnasLokhandwala
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact Form -->
      <div class="contact-form" data-aos="fade-left">
        <h2>Send a Message</h2>

        <form method="POST" action="/contact">
          <div class="form-group">
            <label for="name">Your Name</label>
            <input type="text" id="name" name="name" placeholder="John Doe" required>
          </div>

          <div class="form-group">
            <label for="email">Your Email</label>
            <input type="email" id="email" name="email" placeholder="john@example.com" required>
          </div>

          <div class="form-group">
            <label for="message">Your Message</label>
            <textarea id="message" name="message" rows="5"
              placeholder="Tell me about your project or opportunity..."
              required></textarea>
          </div>

          <button type="submit" class="btn primary">
            Send Message
          </button>
        </form>
      </div>

    </div>

    <!-- CTA -->
    <section class="contact-cta" data-aos="fade-up">
      <p>
        Prefer email or LinkedIn? Feel free to reach out directly —
        I usually respond within 24 hours.
      </p>
    </section>

  </div>
</section>

<%- include("partials/footer") %>
